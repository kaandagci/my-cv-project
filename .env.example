# Anthropic API key - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Jooble API key - ucretsiz, Turkiye dahil 60+ ulkeyi destekler
# Almak icin: https://jooble.org/api/about adresinden kayit olun
JOOBLE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: varsayilan arama konumu (kullanici arayuzden de degistirebilir).
# Sehir ("Istanbul") veya ulke ("Turkiye") adi olabilir.
JOOBLE_LOCATION=Türkiye

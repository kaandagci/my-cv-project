# Gemini API key - https://aistudio.google.com/apikey adresinden ucretsiz alinir
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: kullanilacak Gemini modeli. Varsayilan "gemini-3.6-flash".
GEMINI_MODEL=gemini-3.6-flash

# Jooble API key (opsiyonel ama onerilir) - genel/uluslararasi is arama kaynagi.
# Almak icin: https://jooble.org/api/about
JOOBLE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
JOOBLE_LOCATION=Turkey

# --- Turkiye'ye ozel is arama kaynagi (LinkedIn, Kariyer.net, Indeed, SecretCV) ---
# Jooble'in Turkiye kapsami zayif oldugu icin bu kaynak, Serper.dev uzerinden
# dogrudan bu 4 siteyi tarar. Tek bir API key yeterli, ekstra proje/CSE
# yapilandirmasi gerekmez.
#
# NOT: Google'in kendi "Custom Search JSON API"si DEGIL bu — o API 2025'te
# yeni musterilere kapatildi (yeni GCP projeleri her ayari dogru yapsa bile
# "does not have the access" hatasi aliyor, bu Google'in kendi karari,
# duzeltilemez). Serper.dev bu sorunu olmayan, tek-key'li, basit bir
# alternatif ve 2500 sorguluk ucretsiz deneme kredisi sunuyor.
#
# Almak icin: https://serper.dev adresinden ucretsiz kayit olun, dashboard'dan
# API key'i kopyalayin.
SERPER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

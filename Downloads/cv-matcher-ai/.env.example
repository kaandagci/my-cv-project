# Gemini API key - https://aistudio.google.com/apikey adresinden ucretsiz alinir
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: kullanilacak Gemini modeli. Varsayilan "gemini-3.6-flash" (hizli ve
# ucuz). Daha guclu sonuclar icin "gemini-3.5-pro" gibi bir model de girebilirsiniz
# (guncel model listesi icin https://ai.google.dev/gemini-api/docs/models).
GEMINI_MODEL=gemini-3.6-flash

# Jooble API key - ucretsiz, Turkiye dahil 60+ ulkeyi destekler
# Almak icin: https://jooble.org/api/about adresinden kayit olun
JOOBLE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: varsayilan arama konumu (kullanici arayuzden de degistirebilir).
# Sehir ("Istanbul") veya ulke ("Turkiye") adi olabilir.
JOOBLE_LOCATION=Türkiye
